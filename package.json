{
  "name": "ubiquitous-computing-museum-experience",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "An accessible Greek learning exhibit and on-device computer vision lab, based on an NKUA thesis.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@splidejs/splide": "4.0.6",
    "chart.js": "4.3.3",
    "gsap": "3.12.2",
    "jquery": "3.7.1",
    "typed.js": "2.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.9"
  }
}
